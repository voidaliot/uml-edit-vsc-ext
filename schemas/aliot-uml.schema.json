{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aliot:uml:document:1",
  "title": "Aliot UML document, version 1",
  "description": "Portable PlantUML source and native editor layout. Strict JSON; comments, trailing commas, and duplicate property names are not permitted. Unknown properties are reserved for extensions and retained by source/layout updates.",
  "type": "object",
  "required": ["format", "version", "source", "layouts"],
  "properties": {
    "format": { "const": "aliot-uml" },
    "version": { "const": 1 },
    "source": {
      "type": "string",
      "maxLength": 2097152,
      "description": "The exact PlantUML document, including line endings and comments. The editor additionally enforces a 2 MiB UTF-8 byte limit."
    },
    "layouts": {
      "type": "object",
      "maxProperties": 10000,
      "propertyNames": {
        "minLength": 1,
        "maxLength": 1000,
        "not": { "enum": ["__proto__", "constructor", "prototype"] }
      },
      "additionalProperties": { "$ref": "#/$defs/layout" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "coordinate": { "type": "number", "minimum": -10000000, "maximum": 10000000 },
    "point": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "$ref": "#/$defs/coordinate" },
        "y": { "$ref": "#/$defs/coordinate" },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 10000000 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 10000000 }
      },
      "additionalProperties": true
    },
    "viewport": {
      "type": "object",
      "required": ["x", "y", "zoom"],
      "properties": {
        "x": { "$ref": "#/$defs/coordinate" },
        "y": { "$ref": "#/$defs/coordinate" },
        "zoom": { "type": "number", "minimum": 0.05, "maximum": 10 }
      },
      "additionalProperties": true
    },
    "layout": {
      "type": "object",
      "required": ["positions"],
      "properties": {
        "positions": {
          "type": "object",
          "maxProperties": 20000,
          "propertyNames": { "minLength": 1, "maxLength": 1000 },
          "additionalProperties": { "$ref": "#/$defs/point" }
        },
        "viewport": { "$ref": "#/$defs/viewport" }
      },
      "additionalProperties": true
    }
  }
}
