{
  "name": "aliot-uml-editor",
  "displayName": "Aliot UML Editor",
  "description": "Native React Flow UML diagrams with bidirectional editing of PlantUML text files.",
  "version": "0.3.5",
  "publisher": "aliot",
  "license": "MIT",
  "engines": {
    "vscode": "^1.104.0",
    "node": ">=22"
  },
  "categories": [
    "Visualization",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "plantuml",
    "uml",
    "diagram",
    "react-flow",
    "visual-editor"
  ],
  "main": "./dist/extension.cjs",
  "icon": "media/icon.png",
  "activationEvents": [
    "onCustomEditor:aliot.umlEditor",
    "onLanguage:plantuml"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "plantuml",
        "aliases": [
          "PlantUML",
          "plantuml"
        ],
        "extensions": [
          ".puml",
          ".plantuml",
          ".pu",
          ".iuml"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "json",
        "extensions": [
          ".aliotuml"
        ]
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "*.aliotuml",
        "url": "./schemas/aliot-uml.schema.json"
      }
    ],
    "grammars": [
      {
        "language": "plantuml",
        "scopeName": "source.plantuml",
        "path": "./syntaxes/plantuml.tmLanguage.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "aliot.umlEditor",
        "displayName": "Aliot UML Editor",
        "selector": [
          {
            "filenamePattern": "*.puml"
          },
          {
            "filenamePattern": "*.plantuml"
          },
          {
            "filenamePattern": "*.pu"
          },
          {
            "filenamePattern": "*.iuml"
          },
          {
            "filenamePattern": "*.aliotuml"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "aliotUml.openEditor",
        "title": "Open Diagram",
        "category": "Aliot UML",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "aliotUml.newDiagram",
        "title": "New Diagram",
        "category": "Aliot UML",
        "icon": "$(new-file)"
      },
      {
        "command": "aliotUml.openSource",
        "title": "Open PlantUML Source",
        "category": "Aliot UML",
        "icon": "$(code)"
      },
      {
        "command": "aliotUml.saveAliotDocument",
        "title": "Save Aliot Diagram",
        "category": "Aliot UML",
        "icon": "$(save)"
      },
      {
        "command": "aliotUml.openAliotDocument",
        "title": "Open Aliot Diagram",
        "category": "Aliot UML",
        "icon": "$(folder-opened)"
      },
      {
        "command": "aliotUml.exportPlantUml",
        "title": "Export PlantUML",
        "category": "Aliot UML",
        "icon": "$(export)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "aliotUml.openEditor",
          "when": "(resourceLangId == plantuml || resourceExtname == .aliotuml) && activeCustomEditorId != aliot.umlEditor",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "aliotUml.openEditor",
          "when": "resourceExtname =~ /\\.(puml|plantuml|pu|iuml|aliotuml)$/",
          "group": "navigation@10"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:web": "playwright test",
    "test:corpus": "node scripts/check-corpus.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "preview": "node scripts/preview.mjs",
    "package": "npm run check && vsce package --no-dependencies --allow-missing-repository",
    "vscode:prepublish": "npm run build",
    "test:native": "node scripts/test-native.mjs"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "jsonc-parser": "^3.3.1",
    "katex": "^0.19.1",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "1.104.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@azure/identity": "4.13.0",
    "uuid": "11.1.1"
  },
  "type": "module"
}
