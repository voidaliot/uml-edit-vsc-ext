{
  "format": "aliot-uml",
  "version": 1,
  "source": "@startuml\ntitle Order deployment\nnode \"Application host\" as Host\nartifact \"Order service\" as Service\ndatabase \"Orders\" as Orders\ncloud \"Customers\" as Customers\nHost ..> Service : deploys\nCustomers --> Service : places orders\nService --> Orders : reads / writes\n@enduml\n",
  "layouts": {
    "diagram-1": {
      "positions": {
        "Host": { "x": 80, "y": 80 },
        "Service": { "x": 380, "y": 80 },
        "Orders": { "x": 680, "y": 80 },
        "Customers": { "x": 380, "y": 300 }
      }
    }
  }
}
