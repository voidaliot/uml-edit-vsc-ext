@startuml
actor "Customer" as customer
participant "Checkout" as checkout
participant "Inventory" as inventory
customer -> checkout : Place order
checkout -> inventory : Reserve items
inventory --> checkout : Reserved
checkout --> customer : Confirmation
@enduml

@startuml
left to right direction
actor "Customer" as customer
usecase "Place order" as placeOrder
usecase "Track delivery" as trackDelivery
customer --> placeOrder
customer --> trackDelivery
@enduml

@startuml
component "Storefront" as storefront
component "Order service" as orders
database "Order store" as store
storefront --> orders : HTTPS
orders --> store : SQL
@enduml

@startuml
node "Application host" as host
artifact "Order service" as service
database "Orders" as orders
host --> service : deploys
service --> orders : reads / writes
@enduml

@startuml
[*] --> Draft
state "Draft" as Draft
state "Submitted" as Submitted
state "Delivered" as Delivered
Draft --> Submitted : submit
Submitted --> Delivered : deliver
Delivered --> [*]
@enduml

